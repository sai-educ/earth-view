# The app runs as a free NASA-only build with no credentials.
#
# Copernicus Sentinel imagery is OPTIONAL and OFF by default. To enable it you
# must do BOTH of the following:
#   1. Set the two server credentials below, AND
#   2. Build with VITE_ENABLE_SENTINEL=true (this exposes the Sentinel layers
#      in the UI; without it they stay hidden so the app never offers a layer it
#      can't load).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
VITE_ENABLE_SENTINEL=
